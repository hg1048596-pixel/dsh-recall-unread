  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "recall",
    "鎾ゅ洖"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hg1048596-pixel/dsh-recall-unread.git"
